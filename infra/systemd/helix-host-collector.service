[Unit]
Description=HELIX narrow host monitoring collector
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/helix-infra/scripts/host-collector.py --project helix212 --api-port 18000 --directory /var/lib/helix-monitoring/textfile
User=root
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/helix-monitoring/textfile
