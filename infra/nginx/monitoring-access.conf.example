# Layer one: separate named edge accounts, with unique strong passwords.
# Grafana still requires its own authenticated session and Viewer/Admin role.
# This is layered password authentication, not MFA.
satisfy all;
auth_basic "HELIX monitoring";
auth_basic_user_file /etc/nginx/helix-monitoring.htpasswd;
limit_req zone=helix_monitoring_requests burst=100 nodelay;
limit_req zone=helix_monitoring_login burst=12 nodelay;
limit_req_status 429;
