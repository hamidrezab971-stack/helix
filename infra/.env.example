# Never use production data for rehearsal. Copy this file to infra/.env.
COMPOSE_PROJECT_NAME=helix212
HELIX_IMAGE=helix:phase21.2-COMMIT
APP_PORT=18000
GRAFANA_PORT=13000
# Numeric ownership must match the isolated data. For cutover use stat, not guesses.
APP_UID=10001
APP_GID=10001
APP_DATA_DIR=/ABSOLUTE/isolated-copy/data
APP_ENV_FILE=/ABSOLUTE/private/app.env
TEXTFILE_DIR=/ABSOLUTE/private/textfile
METRICS_TOKEN_FILE=/ABSOLUTE/private/secrets/metrics_token
GRAFANA_PASSWORD_FILE=/ABSOLUTE/private/secrets/grafana_password
GRAFANA_SECRET_KEY_FILE=/ABSOLUTE/private/secrets/grafana_secret_key
# Add output of lock-images.py; placeholders intentionally cannot be deployed.
# NODE_IMAGE=node:<reviewed-version>@sha256:<resolved-digest>
# PYTHON_IMAGE=python:<reviewed-version>@sha256:<resolved-digest>
# PROMETHEUS_IMAGE=prom/prometheus:<reviewed-version>@sha256:<resolved-digest>
# GRAFANA_IMAGE=grafana/grafana:<reviewed-version>@sha256:<resolved-digest>
# NODE_EXPORTER_IMAGE=prom/node-exporter:<reviewed-version>@sha256:<resolved-digest>
