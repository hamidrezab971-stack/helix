APP_NAME=Smooth
DATABASE_URL=sqlite:///./smooth.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://127.0.0.1:5173
UPLOAD_DIR=./uploads
# Optional: built frontend directory for single-origin production hosting.
# FRONTEND_DIST_DIR=/absolute/path/to/frontend/dist
# Optional separate random CAPTCHA signing key (32+ bytes). By default, derived
# from SECRET_KEY with a separate HMAC domain; existing JWTs are preserved.
# CAPTCHA_KEY=generate-a-private-random-key-outside-source-control
PROFILE_MAX_PHOTOS=10
# Optional internal metrics: absent means disabled (404). Never put the token
# itself here. Compose mounts a protected file and sets this variable.
# METRICS_TOKEN_FILE=/run/secrets/metrics_token
